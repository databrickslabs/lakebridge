{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Key Metrics",
      "queryLines": [
        "SELECT 'User Databases' AS Metric, CAST((SELECT COUNT(DISTINCT DatabaseName) FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_user_databases) AS STRING) AS Value\n",
        "UNION ALL SELECT 'Total Objects', CAST((SELECT SUM(TableKindCount) FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_db_object_types) AS STRING)\n",
        "UNION ALL SELECT 'UDFs', CAST((SELECT COUNT(*) FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dwh_udf) AS STRING)\n",
        "UNION ALL SELECT 'Queries Captured', CAST((SELECT COUNT(*) FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dbql_core_info_extract) AS STRING)\n",
        "UNION ALL SELECT 'Storage Used (GB)', CAST((SELECT ROUND(SUM(CURRENT_PERM_MB)/1024.0,1) FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_disk_utilization) AS STRING)"
      ]
    },
    {
      "name": "ds_sys_info",
      "displayName": "System Info",
      "queryLines": [
        "SELECT MAX(CASE WHEN K='VERSION' THEN V END) AS `Version`, CAST(MAX(CASE WHEN K='# of AMPs' THEN CAST(V AS INT) END) AS STRING) AS `AMPs`, MAX(CASE WHEN K='LANGUAGE SUPPORT MODE' THEN V END) AS `Language Mode`, MAX(CASE WHEN K='RELEASE' THEN V END) AS `Release` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_info"
      ]
    },
    {
      "name": "ds_nodes",
      "displayName": "Node Hardware",
      "queryLines": [
        "SELECT CAST(NodeID AS STRING) AS `Node ID`, TRIM(NodeType) AS `Node Type`, CAST(NCPUs AS STRING) AS `CPUs`, CAST(Vproc1 AS STRING) AS `Vprocs`, CAST(ROUND(MemSize/1024.0,1) AS STRING) AS `Memory (GB)`, CAST(ROUND(NodeNormFactor,0) AS STRING) AS `Norm Factor` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_nodes_info"
      ]
    },
    {
      "name": "ds_avg_util",
      "displayName": "Avg Utilization",
      "queryLines": [
        "SELECT 'CPU' AS `Resource`,\n",
        "  CONCAT(CAST(ROUND(AVG((totCPUUExec+totCPUUServ)/(totCPUUExec+totCPUUServ+totCPUIdle)*100),1) AS STRING), ' %') AS `Average`,\n",
        "  CONCAT(CAST(ROUND(MAX((totCPUUExec+totCPUUServ)/(totCPUUExec+totCPUUServ+totCPUIdle)*100),1) AS STRING), ' %') AS `Peak`\n",
        "FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_usage_agg\n",
        "UNION ALL SELECT 'Memory',\n",
        "  CONCAT(CAST(ROUND(AVG((totMemSizeMB-totMemFreeMB)/totMemSizeMB*100),1) AS STRING), ' %'),\n",
        "  CONCAT(CAST(ROUND(MAX((totMemSizeMB-totMemFreeMB)/totMemSizeMB*100),1) AS STRING), ' %')\n",
        "FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_usage_agg\n",
        "UNION ALL SELECT 'I/O Wait',\n",
        "  CONCAT(CAST(ROUND(AVG(totCPUIoWait/(totCPUUExec+totCPUUServ+totCPUIdle)*100),1) AS STRING), ' %'), NULL\n",
        "FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_usage_agg"
      ]
    },
    {
      "name": "ds_cpu",
      "displayName": "CPU Hourly",
      "queryLines": [
        "SELECT CONCAT(DATE_FORMAT(TheDate,'yyyy-MM-dd'),' ',LPAD(CAST(hour_of_day AS STRING),2,'0'),':00') AS `Hour`,\n",
        "  ROUND((totCPUUExec+totCPUUServ)/(totCPUUExec+totCPUUServ+totCPUIdle)*100,1) AS `CPU %`,\n",
        "  ROUND((totMemSizeMB-totMemFreeMB)/totMemSizeMB*100,1) AS `Memory %`\n",
        "FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_usage_agg ORDER BY TheDate, hour_of_day"
      ]
    },
    {
      "name": "ds_storage",
      "displayName": "Storage",
      "queryLines": [
        "SELECT DATABASENAME AS `Database`, CAST(ROUND(CURRENT_PERM_MB/1024.0,2) AS STRING) AS `Used (GB)`, CAST(ROUND(MAX_PERM_MB/1024.0,2) AS STRING) AS `Allocated (GB)`, CAST(CASE WHEN MAX_PERM_MB>0 THEN ROUND(CURRENT_PERM_MB/MAX_PERM_MB*100,1) ELSE 0 END AS STRING) AS `Utilization %` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_sys_disk_utilization WHERE CURRENT_PERM_MB > 0 ORDER BY CURRENT_PERM_MB DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_db_alloc",
      "displayName": "DB Allocation",
      "queryLines": [
        "SELECT DatabaseName AS `Database`, CAST(ROUND(PermSpace/1073741824.0,2) AS STRING) AS `Perm (GB)`, CAST(ROUND(SpoolSpace/1073741824.0,2) AS STRING) AS `Spool (GB)`, CAST(ROUND(TempSpace/1073741824.0,2) AS STRING) AS `Temp (GB)`, TRIM(ProtectionType) AS `Protection`, TRIM(JournalFlag) AS `Journal` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_user_databases ORDER BY PermSpace DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_obj_types",
      "displayName": "Object Types",
      "queryLines": [
        "SELECT CASE TRIM(TableKind) WHEN 'T' THEN 'Table' WHEN 'V' THEN 'View' WHEN 'O' THEN 'Volatile Table' WHEN 'P' THEN 'Procedure' WHEN 'E' THEN 'External SP' WHEN 'M' THEN 'Macro' WHEN 'G' THEN 'Trigger' WHEN 'D' THEN 'JAR' WHEN 'F' THEN 'Standard Function' WHEN 'L' THEN 'Lifecycle Table' WHEN 'C' THEN 'Combined Aggregate' WHEN 'X' THEN 'Auth Object' ELSE TRIM(TableKind) END AS `Object Type`, CAST(CAST(SUM(TableKindCount) AS INT) AS STRING) AS `Count` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_db_object_types GROUP BY 1 ORDER BY SUM(TableKindCount) DESC"
      ]
    },
    {
      "name": "ds_obj_by_db",
      "displayName": "Objects by DB",
      "queryLines": [
        "SELECT DatabaseName AS `Database`, CASE TRIM(TableKind) WHEN 'T' THEN 'Table' WHEN 'V' THEN 'View' WHEN 'P' THEN 'Procedure' WHEN 'E' THEN 'External SP' WHEN 'L' THEN 'Lifecycle' WHEN 'C' THEN 'Combined Agg' WHEN 'D' THEN 'JAR' WHEN 'X' THEN 'Auth' WHEN 'F' THEN 'Function' ELSE TRIM(TableKind) END AS `Object Type`, CAST(CAST(TableKindCount AS INT) AS STRING) AS `Count` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_db_object_types ORDER BY DatabaseName, TableKindCount DESC"
      ]
    },
    {
      "name": "ds_udfs",
      "displayName": "UDFs",
      "queryLines": [
        "SELECT FunctionLanguage AS `Language`, FunctionType AS `Function Type`, CAST(COUNT(*) AS STRING) AS `Count` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dwh_udf GROUP BY 1, 2 ORDER BY COUNT(*) DESC"
      ]
    },
    {
      "name": "ds_q_user",
      "displayName": "Queries by User",
      "queryLines": [
        "WITH combined AS (\n",
        "  SELECT UserName, 1 AS queries, TotalCPUTime AS cpu, TotalIOCount AS io, COALESCE(SpoolUsage,0) AS spool FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dbql_core_info_extract\n",
        "  UNION ALL SELECT Username, QryCNT, SumCPU, SumIO, 0 FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_pdcr_info_agg_extract\n",
        ")\n",
        "SELECT UserName AS `User`, CAST(CAST(SUM(queries) AS INT) AS STRING) AS `Queries`, CAST(ROUND(SUM(cpu),2) AS STRING) AS `CPU (sec)`, CAST(CAST(SUM(io) AS BIGINT) AS STRING) AS `Total I/O`, CAST(ROUND(SUM(spool)/1048576.0,1) AS STRING) AS `Spool (MB)` FROM combined GROUP BY UserName ORDER BY SUM(cpu) DESC"
      ]
    },
    {
      "name": "ds_q_app",
      "displayName": "Queries by App",
      "queryLines": [
        "WITH combined AS (\n",
        "  SELECT TRIM(AppID) AS app, 1 AS q_cnt, TotalCPUTime AS cpu FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dbql_core_info_extract\n",
        "  UNION ALL SELECT TRIM(AppId), QryCNT, SumCPU FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_pdcr_info_agg_extract\n",
        ")\n",
        "SELECT CASE WHEN app='-' THEN 'Direct SQL' WHEN app='' OR app IS NULL THEN 'Unknown' ELSE app END AS `Application`, CAST(CAST(SUM(q_cnt) AS INT) AS STRING) AS `Queries`, CAST(ROUND(SUM(cpu),2) AS STRING) AS `CPU (sec)` FROM combined GROUP BY 1 ORDER BY SUM(q_cnt) DESC"
      ]
    },
    {
      "name": "ds_top_q",
      "displayName": "Top Queries",
      "queryLines": [
        "SELECT UserName AS `User`, CAST(ROUND(TotalCPUTime,3) AS STRING) AS `CPU (sec)`, CAST(CAST(TotalIOCount AS BIGINT) AS STRING) AS `I/O Count`, CAST(ROUND(COALESCE(SpoolUsage,0)/1048576.0,1) AS STRING) AS `Spool (MB)`, CAST(ROUND(TotalFirstRespTime,2) AS STRING) AS `Response (sec)`, LEFT(SQLTextInfo,120) AS `SQL Preview` FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dbql_core_info_extract ORDER BY TotalCPUTime DESC LIMIT 20"
      ]
    },
    {
      "name": "ds_migration",
      "displayName": "Migration",
      "queryLines": [
        "WITH obj AS (SELECT SUM(CASE WHEN TRIM(TableKind)='T' THEN TableKindCount ELSE 0 END) AS t, SUM(CASE WHEN TRIM(TableKind)='V' THEN TableKindCount ELSE 0 END) AS v, SUM(CASE WHEN TRIM(TableKind)='P' THEN TableKindCount ELSE 0 END) AS p, SUM(CASE WHEN TRIM(TableKind) IN ('E','D') THEN TableKindCount ELSE 0 END) AS e, SUM(CASE WHEN TRIM(TableKind)='M' THEN TableKindCount ELSE 0 END) AS m FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_db_object_types),\n",
        "u AS (SELECT COUNT(*) AS n FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_dwh_udf), d AS (SELECT COUNT(*) AS n FROM <CATALOG_NAME>.<SCHEMA_NAME>.td_user_databases)\n",
        "SELECT 'Tables' AS `Category`, CAST(CAST(t AS INT) AS STRING) AS `Count`, 'Low' AS `Complexity` FROM obj UNION ALL SELECT 'Views', CAST(CAST(v AS INT) AS STRING), 'Low' FROM obj UNION ALL SELECT 'Stored Procedures', CAST(CAST(p AS INT) AS STRING), 'Medium' FROM obj UNION ALL SELECT 'External / JARs', CAST(CAST(e AS INT) AS STRING), 'High' FROM obj UNION ALL SELECT 'Macros', CAST(CAST(m AS INT) AS STRING), 'Medium' FROM obj UNION ALL SELECT 'UDFs', CAST(CAST(n AS INT) AS STRING), 'High' FROM u UNION ALL SELECT 'User Databases', CAST(CAST(n AS INT) AS STRING), 'Low' FROM d"
      ]
    }
  ],
